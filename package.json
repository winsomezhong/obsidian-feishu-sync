{
  "name": "obsidian-feishu-sync",
  "version": "0.1.0",
  "description": "Sync Obsidian notes to Feishu/Lark documents",
  "main": "main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.mjs -w",
    "build": "rollup --config rollup.config.mjs --environment BUILD:production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/node": "^20.0.0",
    "obsidian": "^1.4.0",
    "rollup": "^4.0.0",
    "tslib": "^2.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": ["obsidian", "feishu", "lark", "sync", "plugin"],
  "license": "MIT"
}
